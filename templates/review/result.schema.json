{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "template_payload"
  ],
  "properties": {
    "template_payload": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "major",
                  "minor",
                  "nit"
                ]
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "suggestion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "severity",
              "file",
              "line",
              "title",
              "rationale",
              "suggestion"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "findings"
      ],
      "additionalProperties": false
    }
  }
}
